{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhn",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nhn",
      "database_id": "db232a4b-0091-4931-86ec-2c124e4c8a70"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nhn"
    }
  ],

  "vars": {
    "APP_URL": "https://app.nhahanngu.io.vn",
    "MAIL_FROM": "Nhà Hán Ngữ <noreply@nhahanngu.io.vn>",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_REDIRECT_URI": "https://app.nhahanngu.io.vn/api/auth/google/callback",
    "TURNSTILE_SITE_KEY": ""
  },

  "triggers": {
    "crons": [
      "20 2 * * *"
    ]
  }
}
